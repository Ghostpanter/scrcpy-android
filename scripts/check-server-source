#!/bin/sh
# Build and test the pinned (patched) scrcpy server, then compare its
# executable dex with the bundled asset. They must match.

set -eu

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
SCRCPY="$ROOT/vendor/scrcpy"
ASSET="$ROOT/app/src/main/assets/scrcpy-server.jar"

"$ROOT/scripts/check-server"
built=$("$ROOT/scripts/build-server")

echo "check-server-source: unit, lint, checkstyle" >&2
"$SCRCPY/gradlew" -p "$SCRCPY" --no-daemon \
    :server:testDebugUnitTest :server:lint :server:checkstyle >&2

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT INT TERM
unzip -p "$ASSET" classes.dex >"$tmp/asset.dex"
unzip -p "$built" classes.dex >"$tmp/source.dex"
if ! cmp -s "$tmp/asset.dex" "$tmp/source.dex"; then
    echo "check-server-source: asset dex differs from built source" >&2
    sha256sum "$tmp/asset.dex" "$tmp/source.dex" >&2
    exit 1
fi
echo "check-server-source: ok (patched server matches asset)"

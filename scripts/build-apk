#!/bin/sh
# Build a signed release APK.
#
# Required environment:
#   KEYSTORE_PATH   absolute path to a JKS / PKCS12 keystore
#   KEYSTORE_PASS   password for the keystore
#   KEY_ALIAS       alias of the signing key inside the keystore
#   KEY_PASS        password for that key (often the same as KEYSTORE_PASS)
#
# Required tooling:
#   Android build-tools under ANDROID_SDK_ROOT or on PATH (aapt2, apksigner, zipalign).
#
# Usage:
#   scripts/build-apk
#
# Output: prints the absolute path of the signed APK and its sha256.
# The signed APK lives at:
#   app/build/outputs/apk/release/scrcpy-android-<versionName>-release.apk

set -eu

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
OUT_DIR="$ROOT/app/build/outputs/apk/release"

require() {
    name="$1"
    val="$2"
    if [ -z "$val" ]; then
        echo "build-apk: \$$name is not set" >&2
        echo "  see the header of $0 for the required environment" >&2
        exit 1
    fi
}

require KEYSTORE_PATH "${KEYSTORE_PATH:-}"
require KEYSTORE_PASS "${KEYSTORE_PASS:-}"
require KEY_ALIAS "${KEY_ALIAS:-}"
require KEY_PASS "${KEY_PASS:-}"

if [ ! -f "$KEYSTORE_PATH" ]; then
    echo "build-apk: keystore not found at $KEYSTORE_PATH" >&2
    exit 1
fi

"$ROOT/scripts/check-wrapper"
"$ROOT/scripts/check-server"

echo "build-apk: gradle :app:assembleRelease"
cd "$ROOT"
./gradlew --no-daemon :app:assembleRelease

# Prefer the versioned Ghostpanter name; fall back to legacy app-release.apk.
APK=""
for candidate in \
    "$OUT_DIR"/scrcpy-android-*-release.apk \
    "$OUT_DIR"/app-release.apk
do
    if [ -f "$candidate" ]; then
        APK="$candidate"
        break
    fi
done
if [ -z "$APK" ] || [ ! -f "$APK" ]; then
    echo "build-apk: gradle finished but no release APK under $OUT_DIR" >&2
    ls -la "$OUT_DIR" 2>/dev/null || true
    exit 1
fi

SUM=$(sha256sum "$APK" | awk '{print $1}')

find_bt() {
    tool="$1"
    SDK_ROOT="${ANDROID_SDK_ROOT:-${ANDROID_HOME:-}}"
    if [ -n "$SDK_ROOT" ] && [ -d "$SDK_ROOT/build-tools" ]; then
        # Prefer highest installed build-tools.
        latest=$(ls -1 "$SDK_ROOT/build-tools" | sort -V | tail -1)
        if [ -n "$latest" ] && [ -x "$SDK_ROOT/build-tools/$latest/$tool" ]; then
            echo "$SDK_ROOT/build-tools/$latest/$tool"
            return
        fi
    fi
    if command -v "$tool" >/dev/null 2>&1; then
        command -v "$tool"
        return
    fi
    echo ""
}

APKSIGNER=$(find_bt apksigner)
AAPT2=$(find_bt aapt2)
ZIPALIGN=$(find_bt zipalign)
if [ -z "$APKSIGNER" ] || [ -z "$AAPT2" ] || [ -z "$ZIPALIGN" ]; then
    echo "build-apk: apksigner/aapt2/zipalign required under ANDROID_SDK_ROOT/build-tools" >&2
    exit 1
fi

echo "build-apk: apksigner verify"
if ! verify_out=$("$APKSIGNER" verify --verbose --print-certs "$APK" 2>&1); then
    printf '%s\n' "$verify_out" >&2
    echo "build-apk: apksigner rejected $APK" >&2
    exit 1
fi
printf '%s\n' "$verify_out" | sed 's/^/  /'

"$ZIPALIGN" -c -P 16 4 "$APK" || "$ZIPALIGN" -c 4 "$APK"

actual_permissions=$("$AAPT2" dump permissions "$APK")
echo "$actual_permissions" | grep -q "package: com.ghostpanter.scrcpy" \
    || { echo "build-apk: unexpected package in permissions dump:" >&2; printf '%s\n' "$actual_permissions" >&2; exit 1; }
echo "$actual_permissions" | grep -q "android.permission.INTERNET" \
    || { echo "build-apk: missing INTERNET permission" >&2; exit 1; }

badging=$("$AAPT2" dump badging "$APK")
echo "$badging" | grep -q "versionName='0.5.19-ghostpanter'" \
    || { echo "build-apk: unexpected versionName" >&2; echo "$badging" | head -1 >&2; exit 1; }
echo "$badging" | grep -q "minSdkVersion:'31'" \
    || { echo "build-apk: unexpected minSdk" >&2; exit 1; }
echo "$badging" | grep -q "targetSdkVersion:'37'" \
    || { echo "build-apk: unexpected targetSdk" >&2; exit 1; }
echo "$badging" | grep -q "native-code: 'arm64-v8a' 'x86_64'" \
    || { echo "build-apk: unexpected ABIs" >&2; echo "$badging" | sed -n '/native-code:/p' >&2; exit 1; }

# Legacy download name used by the GitHub release asset.
cp -f "$APK" "$ROOT/artifacts/scrcpy-android.apk"
ART_SUM=$(sha256sum "$ROOT/artifacts/scrcpy-android.apk" | awk '{print $1}')

echo "build-apk: $APK"
echo "build-apk: sha256 $SUM"
echo "build-apk: artifacts/scrcpy-android.apk sha256 $ART_SUM"

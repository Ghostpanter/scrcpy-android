#!/bin/sh
# Build a signed release APK.
#
# Required environment:
#   KEYSTORE_PATH   absolute path to a JKS / PKCS12 keystore
#   KEYSTORE_PASS   password for the keystore
#   KEY_ALIAS       alias of the signing key inside the keystore
#   KEY_PASS        password for that key (often the same as KEYSTORE_PASS)
#
# Required tooling:
#   Android build-tools under ANDROID_SDK_ROOT or on PATH (aapt2, apksigner, zipalign).
#
# Usage:
#   scripts/build-apk
#
# Output: prints the absolute path of the signed APK and its sha256.
# The signed APK lives at:
#   app/build/outputs/apk/release/scrcpy-android-<versionName>-release.apk

set -eu

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
OUT_DIR="$ROOT/app/build/outputs/apk/release"

require() {
    name="$1"
    val="$2"
    if [ -z "$val" ]; then
        echo "build-apk: \$$name is not set" >&2
        echo "  see the header of $0 for the required environment" >&2
        exit 1
    fi
}

require KEYSTORE_PATH "${KEYSTORE_PATH:-}"
require KEYSTORE_PASS "${KEYSTORE_PASS:-}"
require KEY_ALIAS "${KEY_ALIAS:-}"
require KEY_PASS "${KEY_PASS:-}"

if [ ! -f "$KEYSTORE_PATH" ]; then
    echo "build-apk: keystore not found at $KEYSTORE_PATH" >&2
    exit 1
fi

"$ROOT/scripts/check-wrapper"
"$ROOT/scripts/check-server"

echo "build-apk: gradle :app:assembleRelease"
cd "$ROOT"
./gradlew --no-daemon :app:assembleRelease

# Prefer the versioned Ghostpanter name; fall back to legacy app-release.apk.
APK=""
for candidate in \
    "$OUT_DIR"/scrcpy-android-*-release.apk \
    "$OUT_DIR"/app-release.apk
do
    if [ -f "$candidate" ]; then
        APK="$candidate"
        break
    fi
done
if [ -z "$APK" ] || [ ! -f "$APK" ]; then
    echo "build-apk: gradle finished but no release APK under $OUT_DIR" >&2
    ls -la "$OUT_DIR" 2>/dev/null || true
    exit 1
fi

find_bt() {
    tool="$1"
    SDK_ROOT="${ANDROID_SDK_ROOT:-${ANDROID_HOME:-}}"
    if [ -n "$SDK_ROOT" ] && [ -d "$SDK_ROOT/build-tools" ]; then
        latest=$(ls -1 "$SDK_ROOT/build-tools" | sort -V | tail -1)
        if [ -n "$latest" ] && [ -x "$SDK_ROOT/build-tools/$latest/$tool" ]; then
            echo "$SDK_ROOT/build-tools/$latest/$tool"
            return
        fi
    fi
    if command -v "$tool" >/dev/null 2>&1; then
        command -v "$tool"
        return
    fi
    echo ""
}

APKSIGNER=$(find_bt apksigner)
AAPT2=$(find_bt aapt2)
ZIPALIGN=$(find_bt zipalign)
if [ -z "$APKSIGNER" ] || [ -z "$AAPT2" ] || [ -z "$ZIPALIGN" ]; then
    echo "build-apk: apksigner/aapt2/zipalign required under ANDROID_SDK_ROOT/build-tools" >&2
    exit 1
fi

# ColorOS: strip unprotected AGP META-INF blobs, then re-sign V1+V2 so OEM
# JAR verifiers do not see unsigned META-INF entries beside CERT.*.
echo "build-apk: ColorOS clean META-INF + re-sign V1+V2"
clean_apk="$OUT_DIR/.coloros-clean.apk"
python3 - "$APK" "$clean_apk" <<'PY'
import sys, zipfile
src, dst = sys.argv[1], sys.argv[2]
drop_exact = {
    "META-INF/MANIFEST.MF",
    "META-INF/version-control-info.textproto",
}
with zipfile.ZipFile(src, "r") as zin, zipfile.ZipFile(dst, "w") as zout:
    for info in zin.infolist():
        name = info.filename
        if name in drop_exact:
            continue
        if name.startswith("META-INF/") and name.endswith((".SF", ".RSA", ".DSA", ".EC")):
            continue
        if name.startswith("META-INF/com/android/build/gradle/"):
            continue
        data = zin.read(name)
        new = zipfile.ZipInfo(filename=name, date_time=info.date_time)
        new.compress_type = info.compress_type
        new.external_attr = info.external_attr
        new.create_system = info.create_system
        zout.writestr(new, data)
PY
aligned_apk="$OUT_DIR/.coloros-aligned.apk"
"$ZIPALIGN" -f 4 "$clean_apk" "$aligned_apk"
"$APKSIGNER" sign \
    --ks "$KEYSTORE_PATH" \
    --ks-key-alias "$KEY_ALIAS" \
    --ks-pass env:KEYSTORE_PASS \
    --key-pass env:KEY_PASS \
    --v1-signing-enabled true \
    --v2-signing-enabled true \
    --v3-signing-enabled false \
    --v4-signing-enabled false \
    --min-sdk-version 28 \
    --out "$APK" \
    "$aligned_apk"
rm -f "$clean_apk" "$aligned_apk" "${APK}.idsig"
SUM=$(sha256sum "$APK" | awk '{print $1}')

echo "build-apk: apksigner verify"
if ! verify_out=$("$APKSIGNER" verify --verbose --print-certs "$APK" 2>&1); then
    printf '%s\n' "$verify_out" >&2
    echo "build-apk: apksigner rejected $APK" >&2
    exit 1
fi
printf '%s\n' "$verify_out" | sed 's/^/  /'

# minSdk>=24 makes default verify omit V1 even when META-INF is valid.
# ColorOS-oriented check: force API-23 verification so V1 must report true.
echo "build-apk: apksigner verify --min-sdk-version 23 (require V1+V2)"
if ! v1_out=$("$APKSIGNER" verify --verbose --min-sdk-version 23 "$APK" 2>&1); then
    printf '%s\n' "$v1_out" >&2
    echo "build-apk: V1/V2 verify at min-sdk 23 failed" >&2
    exit 1
fi
printf '%s\n' "$v1_out" | grep -q 'Verified using v1 scheme (JAR signing): true' \
    || { echo "build-apk: V1 signature missing/invalid (ColorOS needs JAR/V1)" >&2; printf '%s\n' "$v1_out" >&2; exit 1; }
printf '%s\n' "$v1_out" | grep -q 'Verified using v2 scheme (APK Signature Scheme v2): true' \
    || { echo "build-apk: V2 signature missing/invalid" >&2; printf '%s\n' "$v1_out" >&2; exit 1; }
if printf '%s\n' "$v1_out" | grep -q 'not protected by signature'; then
    echo "build-apk: unprotected META-INF entries remain:" >&2
    printf '%s\n' "$v1_out" | grep 'not protected by signature' | sed 's/^/  /' >&2
    exit 1
fi
printf '%s\n' "$v1_out" | sed 's/^/  /'

"$ZIPALIGN" -c 4 "$APK"

actual_permissions=$("$AAPT2" dump permissions "$APK")
echo "$actual_permissions" | grep -q "package: com.ghostpanter.scrcpy" \
    || { echo "build-apk: unexpected package in permissions dump:" >&2; printf '%s\n' "$actual_permissions" >&2; exit 1; }
echo "$actual_permissions" | grep -q "android.permission.INTERNET" \
    || { echo "build-apk: missing INTERNET permission" >&2; exit 1; }

badging=$("$AAPT2" dump badging "$APK")
echo "$badging" | grep -q "versionName='0.5.27-tablet'" \
    || { echo "build-apk: unexpected versionName" >&2; echo "$badging" | head -1 >&2; exit 1; }
echo "$badging" | grep -q "minSdkVersion:'28'" \
    || { echo "build-apk: unexpected minSdk" >&2; exit 1; }
echo "$badging" | grep -q "targetSdkVersion:'34'" \
    || { echo "build-apk: unexpected targetSdk" >&2; exit 1; }
echo "$badging" | grep -q "compileSdkVersion='34'" \
    || { echo "build-apk: unexpected compileSdk (want 34 for ColorOS)" >&2; echo "$badging" | head -1 >&2; exit 1; }
# Universal APK: every ABI present in conscrypt + spake2.
native_line=$(printf '%s\n' "$badging" | sed -n '/native-code:/p')
for abi in armeabi-v7a arm64-v8a x86 x86_64; do
    printf '%s\n' "$native_line" | grep -q "'$abi'" \
        || { echo "build-apk: missing ABI $abi" >&2; echo "$native_line" >&2; exit 1; }
done
# x86 must not match as a prefix of x86_64 only; the quoted token above handles that.
echo "build-apk: ABIs $native_line"

# Legacy download name used by the GitHub release asset.
cp -f "$APK" "$ROOT/artifacts/scrcpy-android.apk"
ART_SUM=$(sha256sum "$ROOT/artifacts/scrcpy-android.apk" | awk '{print $1}')

echo "build-apk: $APK"
echo "build-apk: sha256 $SUM"
echo "build-apk: artifacts/scrcpy-android.apk sha256 $ART_SUM"
